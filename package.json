{
  "name": "tenstorrent-cli",
  "version": "0.2.0",
  "description": "Tenstorrent CLI: chat REPL plus Wan 2.2 video generation.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tenstorrent": "./bin/tenstorrent"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target=bun --outdir=dist",
    "start": "bun run ./bin/tenstorrent",
    "test": "bun run typecheck && bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "typescript": "^5.9.3"
  }
}
